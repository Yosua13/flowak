# Application Server
PORT=3001
APP_ENV=development
JWT_SECRET=your_jwt_secret_key_minimum_32_characters_here
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3001,http://127.0.0.1:5173,http://127.0.0.1:3001

# Google Gemini AI (Optional: for AI Flow Generator feature)
GEMINI_API_KEY=your_gemini_api_key_here

# PostgreSQL Database
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_postgres_password_here
DB_NAME=flowak

# Redis (Caching & Session Blacklist)
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# RabbitMQ (Message Broker & SSE Broadcast)
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
