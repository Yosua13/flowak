{
  "openapi": "3.1.0",
  "info": { "title": "Flowak API", "version": "v1", "description": "Actual HTTP surface served by the Go/Gin runtime. All /api routes except authentication and invitation acceptance require a bearer access token; GET event streams may use the short-lived HttpOnly SSE cookie." },
  "servers": [{ "url": "/" }],
  "paths": {
    "/api/auth/register": { "post": { "summary": "Register a user" } },
    "/api/auth/login": { "post": { "summary": "Create access and refresh session" } },
    "/api/auth/refresh": { "post": { "summary": "Rotate refresh session" } },
    "/api/auth/logout": { "post": { "summary": "Revoke refresh session" } },
    "/api/auth/password-reset/request": { "post": { "summary": "Request password reset" } },
    "/api/invitations/accept": { "post": { "summary": "Accept invitation" } },
    "/api/projects": { "get": { "summary": "List tenant projects" }, "post": { "summary": "Create project" } },
    "/api/projects/{id}": { "get": { "summary": "Read project and modules" }, "delete": { "summary": "Archive project" } },
    "/api/projects/{id}/restore": { "post": { "summary": "Restore archived project" } },
    "/api/projects/{id}/members": { "get": { "summary": "List project members" }, "post": { "summary": "Add project member" } },
    "/api/projects/{id}/members/{userId}": { "delete": { "summary": "Remove project member" } },
    "/api/projects/{id}/modules": { "get": { "summary": "List normalized modules" }, "post": { "summary": "Create module" } },
    "/api/modules/{id}": { "put": { "summary": "Update module graph/specification" }, "delete": { "summary": "Archive module" } },
    "/api/projects/{id}/work-items": { "get": { "summary": "List filtered, cursor-paginated work items" }, "post": { "summary": "Create work item" } },
    "/api/work-items/{key}": { "get": { "summary": "Read work item" }, "patch": { "summary": "Update work item fields" } },
    "/api/work-items/{key}/transitions": { "post": { "summary": "Transition work item with history" } },
    "/api/work-items/{key}/comments": { "get": { "summary": "List work item comments" }, "post": { "summary": "Create work item comment and mentions" } },
    "/api/work-items/{key}/activity": { "get": { "summary": "Read safe work item activity" } },
    "/api/work-items/{key}/artifacts": { "get": { "summary": "Read checklist, watcher, link, and evidence metadata" } },
    "/api/work-items/{key}/artifacts/{kind}": { "post": { "summary": "Create work item artifact" } },
    "/api/work-items/{key}/artifacts/{kind}/{artifactId}": { "patch": { "summary": "Update work item artifact" }, "delete": { "summary": "Delete work item artifact" } },
    "/api/nodes/{id}/comments": { "get": { "summary": "List node comments" }, "post": { "summary": "Create node comment" } },
    "/api/nodes/{id}/activity": { "get": { "summary": "Read safe node activity" } },
    "/api/comments/{id}": { "patch": { "summary": "Edit or resolve own comment" } },
    "/api/projects/{id}/derived-view-data": { "get": { "summary": "Read status, calendar, analytics, document, and export source data" } },
    "/api/projects/{id}/events": { "get": { "summary": "Tenant-scoped SSE invalidation and Last-Event-ID replay" } },
    "/api/notifications": { "get": { "summary": "List user notifications" } },
    "/api/notifications/read": { "post": { "summary": "Mark notifications read" } },
    "/api/modules/{id}/publish": { "post": { "summary": "Publish immutable module baseline" } },
    "/api/modules/{id}/versions/{version}/restore": { "post": { "summary": "Restore baseline as a new draft" } },
    "/api/projects/{id}/environments": { "get": { "summary": "List project environments" }, "post": { "summary": "Create environment" } },
    "/api/environments/{id}": { "patch": { "summary": "Update environment" }, "delete": { "summary": "Delete environment" } },
    "/api/environments/{id}/variables": { "get": { "summary": "List variable metadata" }, "post": { "summary": "Upsert encrypted variable" } },
    "/api/environments/{environmentId}/variables/{variableId}": { "delete": { "summary": "Delete environment variable" } },
    "/api/nodes/{id}/api-requests": { "get": { "summary": "List API contracts" }, "post": { "summary": "Create API contract" } },
    "/api/api-requests/{id}": { "patch": { "summary": "Update API contract" }, "delete": { "summary": "Delete API contract" } },
    "/api/api-requests/{id}/runs": { "get": { "summary": "List redacted run history" }, "post": { "summary": "Run contract through server-side allowlisted proxy" } },
    "/api/api-runs/{id}/evidence": { "patch": { "summary": "Mark API run as evidence" } },
    "/api/ai/generate-flow": { "post": { "summary": "Generate reviewable flow draft" } },
    "/api/ai/audit-flow": { "post": { "summary": "Generate reviewable audit findings" } },
    "/api/users": { "get": { "summary": "List organization users" }, "post": { "summary": "Create invited user" } },
    "/api/users/{id}": { "delete": { "summary": "Delete user" } },
    "/api/users/dashboard-stats": { "get": { "summary": "Read user dashboard summary" } },
    "/api/invitations": { "post": { "summary": "Create invitation" } }
  },
  "components": { "schemas": { "Error": { "type": "object", "required": ["error"], "properties": { "error": { "type": "string" }, "error_code": { "type": "string" } } } }, "securitySchemes": { "bearerAuth": { "type": "http", "scheme": "bearer", "bearerFormat": "JWT" } } }
}
